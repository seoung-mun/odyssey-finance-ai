#!/bin/sh
# 브랜치 이름 규칙 + main/develop 직접 푸시 차단.
# 비공개 레포는 GitHub 브랜치 보호가 유료라, 이 훅이 실질적인 방어선.
branch=$(git rev-parse --abbrev-ref HEAD)

case "$branch" in
  main|develop)
    echo "✗ $branch 에 직접 푸시할 수 없습니다. feature/* 브랜치를 만들어 PR로 올리세요." >&2
    exit 1
    ;;
esac

if ! printf '%s' "$branch" | grep -qE '^(feature|release|hotfix)/[a-z0-9._-]+$'; then
  cat >&2 <<EOF
✗ 브랜치 이름 규칙 위반: $branch

  형식: feature/<설명> | release/<버전> | hotfix/<설명>  (소문자·하이픈)
  예시: feature/analysis-montecarlo-block-bootstrap
EOF
  exit 1
fi
