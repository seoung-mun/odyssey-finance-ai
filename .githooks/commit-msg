#!/bin/sh
# 커밋 메시지가 Conventional Commits 형식인지 검사. 규칙 문서는 .claude/skills/git-flow/
subject=$(head -n1 "$1")

# merge/revert/fixup 커밋은 git이 자동 생성하므로 통과
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -qE '^(feat|fix|refactor|test|docs|chore|perf|build|revert)\((core|analysis|engine|web|infra|docs)\): .+'; then
  cat >&2 <<'EOF'
✗ 커밋 메시지 형식 오류

  형식: <type>(<scope>): <제목>
  type : feat fix refactor test docs chore perf build revert
  scope: core analysis engine web infra docs

  예시: feat(engine): 블록 부트스트랩으로 몬테카를로 리샘플링 교체
EOF
  exit 1
fi

if printf '%s' "$subject" | grep -qE '\.$'; then
  echo "✗ 제목 끝에 마침표를 쓰지 않습니다: $subject" >&2
  exit 1
fi

if [ "$(printf '%s' "$subject" | wc -m)" -gt 72 ]; then
  echo "✗ 제목이 72자를 넘습니다. 자세한 설명은 본문에 쓰세요." >&2
  exit 1
fi
