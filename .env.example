POSTGRES_DB=dacon
POSTGRES_USER=dacon
POSTGRES_PASSWORD=replace-with-random-password
INTERNAL_API_TOKEN=replace-with-random-token
REDIS_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
API_ADDRESS=localhost
HTTP_ADDRESS=:80
PUBLIC_BIND_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
APP_CORS_ALLOWED_ORIGIN=
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=e2e
EXPLANATION_AI_ENABLED=false
EXPLANATION_TIMEOUT=15s
CHAT_AI_ENABLED=false
CHAT_TIMEOUT=3s
OLLAMA_CHAT_MODEL=qwen3:0.6b-q4_K_M
# 외부 AI API 자격증명 이름. 이번 P0 런타임에는 주입하거나 사용하지 않는다.
OPEN_ROUTER_API_KEY=
# 금융결제원(FSS) 발급 키. Windows 편집기로 저장하면 줄 끝에 CR/공백이 붙어 값이 통째로
# 거부(err_cd=010)될 수 있으니 값 끝에 공백·개행이 없는지 확인한다.
FINLIFE_API_KEY=
E2E_TOKEN=방금_생성한_별도_토큰
